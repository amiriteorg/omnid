<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The i2pd app, whose router omnid uses for .i2p (I2pd.kt). -->
    <queries>
        <package android:name="org.purplei2p.i2pd" />
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Omnid">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Share an onion, magnet or URL to omnid to crawl it. -->
            <intent-filter android:label="@string/share_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- GeckoView, private, every request through the daemon. Not exported: only
             omnid's own search page opens it. A task of its own, so its tabs stay open
             behind the search page and the launcher icon does not close them. -->
        <activity
            android:name=".BrowserActivity"
            android:autoRemoveFromRecents="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|density"
            android:exported="false"
            android:label="@string/browser_label"
            android:launchMode="singleTask"
            android:taskAffinity="cc.wckd.omnid.browser"
            android:theme="@style/Theme.Omnid.Browser"
            android:windowSoftInputMode="adjustResize" />

        <!-- One screen of settings; not exported. -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings" />

        <!-- specialUse: a long-running local gateway and index has no closer
             type, and dataSync is cut off after six hours on Android 15. -->
        <service
            android:name=".OmnidService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Local search index and multi-network gateway (Tor, I2P) that the user's own UI queries over loopback, crawling while charging" />
        </service>
    </application>
</manifest>
