<?xml version="1.0" encoding="utf-8"?>
<!-- The dashed rule between rows, as between the search page's results. 3dp tall for a 1dp dash:
     a line shape is drawn inside its bounds less half the stroke, so a 1dp-tall one draws nothing. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android" android:insetLeft="8dp" android:insetRight="8dp">
    <shape android:shape="line">
        <stroke android:width="1dp" android:color="@color/ink_2" android:dashWidth="3dp" android:dashGap="3dp" />
        <size android:height="3dp" />
    </shape>
</inset>
