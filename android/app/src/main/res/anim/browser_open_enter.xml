<?xml version="1.0" encoding="utf-8"?>
<!-- The browser rises from the result that opened it: a short scale and fade toward the reader. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/decelerate_cubic"
    android:duration="240">
    <alpha android:fromAlpha="0" android:toAlpha="1" />
    <scale android:fromXScale="0.94" android:toXScale="1" android:fromYScale="0.94" android:toYScale="1"
        android:pivotX="50%" android:pivotY="60%" />
</set>
